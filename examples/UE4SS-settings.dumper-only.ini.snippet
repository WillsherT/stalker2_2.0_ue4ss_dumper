# Merge these values into your existing UE4SS-settings.ini.
# This is a dump-only profile. It intentionally disables gameplay hooks.

[General]
UseCache = 0
bUseUObjectArrayCache = false
DefaultFNameToStringMethod = Scan

[Hooks]
HookProcessInternal = 0
HookProcessLocalScriptFunction = 0
HookInitGameState = 0
HookLoadMap = 0
HookCallFunctionByNameWithArguments = 0
HookBeginPlay = 0
HookEndPlay = 0
HookLocalPlayerExec = 0
HookAActorTick = 0
HookEngineTick = 0
HookGameViewportClientTick = 0
HookUObjectProcessEvent = 0
HookProcessConsoleExec = 0
HookUStructLink = 0
